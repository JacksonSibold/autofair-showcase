# Copy to .env.local and replace each value with your own test-mode credentials.
# Never commit .env.local.

# Public app URL used for Stripe success/cancel redirects.
NEXT_PUBLIC_APP_URL=REPLACE_ME
NEXT_PUBLIC_SUPABASE_URL=REPLACE_ME
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME

# Server-only Supabase key. Bypasses row-level security; keep it server-side.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Vehicle listings and OEM incentives. Optional: without it, pricing uses heuristics.
MARKETCHECK_API_KEY=REPLACE_ME

# Negotiation model. Required for replies to dealer messages.
OPENAI_API_KEY=REPLACE_ME

# Stripe test-mode keys. The webhook secret comes from `stripe listen` or the dashboard.
STRIPE_SECRET_KEY=REPLACE_ME
STRIPE_WEBHOOK_SECRET=REPLACE_ME

# Outbound and inbound email. Optional: without SendGrid, emails are logged instead of sent.
SENDGRID_API_KEY=REPLACE_ME
SENDGRID_FROM_EMAIL=REPLACE_ME

# Outbound and inbound SMS. Optional: without Twilio, texts are logged instead of sent.
TWILIO_ACCOUNT_SID=REPLACE_ME
TWILIO_AUTH_TOKEN=REPLACE_ME
TWILIO_PHONE_NUMBER=REPLACE_ME
